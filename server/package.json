{
  "name": "pbsi-server",
  "version": "1.0.0",
  "private": true,
  "description": "PBSI School Management System API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "set TS_NODE_TRANSPILE_ONLY=true&& node --env-file=.env --watch --experimental-specifier-resolution=node --loader ts-node/esm src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "typescript": "^5.6.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "ts-node": "^10.9.2"
